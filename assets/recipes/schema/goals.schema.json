{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GoalsFile",
  "type": "object",
  "properties": {
    "$schema": {
      "description": "Points editors at the generated JSON Schema, for autocomplete.",
      "type": [
        "string",
        "null"
      ]
    },
    "format": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0,
      "description": "2: `scale` and `part_of` (format 1 had `horizon`)."
    },
    "goals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/GoalDefinition"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "format",
    "goals"
  ],
  "$defs": {
    "Condition": {
      "description": "Game states a goal can wait for. The game reports each when it starts to hold.",
      "oneOf": [
        {
          "description": "Every `configure.cables` patch of a placed machine is made, so its voice sounds.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "machine_configured"
            },
            "machine": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "machine"
          ]
        },
        {
          "description": "A flowing stream waters a tree of this mine.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "tree_watered"
            },
            "mine": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "mine"
          ]
        },
        {
          "description": "A tree of this mine has reached this bloom level (its growth.json) or above.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "tree_grown"
            },
            "mine": {
              "type": "string"
            },
            "level": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "mine",
            "level"
          ]
        },
        {
          "description": "The player's inventory holds at least this many of the item.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "item_held"
            },
            "item": {
              "type": "string"
            },
            "quantity": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "item",
            "quantity"
          ]
        }
      ]
    },
    "GoalDefinition": {
      "type": "object",
      "properties": {
        "after": {
          "description": "Goals that must be complete before this one opens (beyond file order).",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "condition": {
          "description": "Minor goals only: met when this game state holds. Exactly one of `requires` and `condition`.",
          "$ref": "#/$defs/Condition"
        },
        "description": {
          "description": "One line the hub shows under the name.",
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "requires": {
          "description": "Minor goals only: items delivered to meet it (delivery is not built yet). Exactly one of `requires` and `condition`.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Stack"
          }
        },
        "unlocks": {
          "description": "Items discovered in the recipe book when it completes.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scale": {
          "$ref": "#/$defs/Scale"
        },
        "part_of": {
          "description": "Minor goals only: the major goal this is a step of. A major goal's steps are done in file order.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "description",
        "scale"
      ]
    },
    "Stack": {
      "type": "object",
      "properties": {
        "item": {
          "type": "string"
        },
        "quantity": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "item",
        "quantity"
      ]
    },
    "Scale": {
      "description": "A major goal is a long arc made of minor goals (its steps); it completes with its last step.",
      "type": "string",
      "enum": [
        "major",
        "minor"
      ]
    }
  }
}
