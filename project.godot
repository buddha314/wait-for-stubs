; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="wait-for-stubs"
config/description="Godot port of stubby-music: a modular-synthesis factory builder."
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.8", "Forward Plus")

[audio]

driver/mix_rate=48000
master_clock/tempo_bpm=1.0
master_clock/beats_per_bar=4

[autoload]

Rules="*res://autoload/rules.gd"
PlayerInventory="*res://autoload/inventory.gd"
Calendar="*res://autoload/calendar.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080

[editor_plugins]

enabled=PackedStringArray("res://addons/sky_3d/plugin.cfg", "res://addons/gloot/plugin.cfg")

