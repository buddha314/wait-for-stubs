[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="interact"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

anti_aliasing/quality/msaa_3d=2

[importer_defaults]

scene={
"import_script/path": "res://tools/import/asset_lod_import.gd"
}
